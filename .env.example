# Скопируйте в .env и заполните. Секреты не коммитьте.
BOT_TOKEN=123456:replace-me

# ID супергрупп (обычно отрицательные, вида -1001234567890). Узнать можно командой /chatid.
APPLICATIONS_CHAT_ID=-1001234567890
SUPPORT_CHAT_ID=-1001234567890
SUGGESTIONS_CHAT_ID=-1001234567890
ADMIN_CHAT_ID=-1001234567890

# Порог сообщений для whitelist и статистика (MESSAGE_REQUIREMENT_ENABLED=false отключает подсчёт).
MESSAGE_THRESHOLD=100
MESSAGE_REQUIREMENT_ENABLED=true
# Сколько участников показывать в «статистике» (по умолчанию 20).
STATS_TOP_LIMIT=20

# Начальный состав администрации: telegram_id:уровень, через запятую. Дальше роли живут в БД.
STAFF=123456789:5,987654321:2

DATABASE_URL=sqlite+aiosqlite:///./mellow.db
# PostgreSQL для нескольких процессов:
# DATABASE_URL=postgresql+asyncpg://mellow:password@db:5432/mellow
POSTGRES_PASSWORD=replace-with-a-strong-database-password

# Paper-плагин MellowBridge. Токен тот же, что в plugins/MellowBridge/config.yml.
MINECRAFT_API_URL=http://127.0.0.1:8765
MINECRAFT_API_TOKEN=replace-with-a-long-random-secret
MINECRAFT_API_TIMEOUT=8

FORM_QUESTIONS_FILE=config/questions.yml
LOG_LEVEL=INFO
